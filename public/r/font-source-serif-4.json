{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "font-source-serif-4",
  "title": "Source Serif 4",
  "description": "Source Serif 4, which Royal's font tokens read from --font-source-serif.",
  "type": "registry:font",
  "font": {
    "family": "'Source Serif 4', Georgia, serif",
    "provider": "google",
    "import": "Source_Serif_4",
    "variable": "--font-source-serif",
    "subsets": [
      "latin"
    ]
  }
}