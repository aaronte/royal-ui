{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "royal",
  "homepage": "https://github.com/aaronte/royal-ui",
  "items": [
    {
      "name": "font-source-serif-4",
      "type": "registry:font",
      "title": "Source Serif 4",
      "description": "Source Serif 4, which Royal's font tokens read from --font-source-serif.",
      "font": {
        "family": "'Source Serif 4', Georgia, serif",
        "provider": "google",
        "import": "Source_Serif_4",
        "variable": "--font-source-serif",
        "subsets": [
          "latin"
        ]
      }
    },
    {
      "name": "font-instrument-sans",
      "type": "registry:font",
      "title": "Instrument Sans",
      "description": "Instrument Sans, which Royal's font tokens read from --font-instrument-sans.",
      "font": {
        "family": "'Instrument Sans', Arial, sans-serif",
        "provider": "google",
        "import": "Instrument_Sans",
        "variable": "--font-instrument-sans",
        "subsets": [
          "latin"
        ]
      }
    },
    {
      "name": "font-ibm-plex-mono",
      "type": "registry:font",
      "title": "IBM Plex Mono",
      "description": "IBM Plex Mono, which Royal's font tokens read from --font-ibm-plex-mono.",
      "font": {
        "family": "'IBM Plex Mono', ui-monospace, monospace",
        "provider": "google",
        "import": "IBM_Plex_Mono",
        "variable": "--font-ibm-plex-mono",
        "subsets": [
          "latin"
        ],
        "weight": [
          "400",
          "500"
        ]
      }
    },
    {
      "name": "royal",
      "type": "registry:theme",
      "title": "Royal",
      "description": "Royal's tokens and the stylesheet that restyles the shadcn components, light and dark. Every Royal component installs it.",
      "dependencies": [
        "tw-animate-css@^1.4.0"
      ],
      "registryDependencies": [
        "https://raw.githubusercontent.com/aaronte/royal-ui/main/public/r/font-source-serif-4.json",
        "https://raw.githubusercontent.com/aaronte/royal-ui/main/public/r/font-instrument-sans.json",
        "https://raw.githubusercontent.com/aaronte/royal-ui/main/public/r/font-ibm-plex-mono.json"
      ],
      "files": [
        {
          "path": "src/styles/tokens.css",
          "type": "registry:file",
          "target": "@lib/royal/tokens.css"
        },
        {
          "path": "src/styles/royal.css",
          "type": "registry:file",
          "target": "@lib/royal/royal.css"
        }
      ],
      "css": {
        "@import \"../lib/royal/tokens.css\"": {},
        "@import \"../lib/royal/royal.css\"": {},
        "@custom-variant dark (&:where(.dark, .dark *))": {}
      },
      "cssVars": {
        "theme": {
          "font-sans": "var(--royal-font-body)",
          "font-heading": "var(--royal-font-display)",
          "font-mono": "var(--royal-font-code)",
          "radius-sm": "var(--royal-radius-control)",
          "radius-md": "var(--royal-radius-control)",
          "radius-lg": "var(--royal-radius-panel)",
          "radius-xl": "var(--royal-radius-panel)"
        },
        "light": {
          "background": "var(--royal-color-paper)",
          "foreground": "var(--royal-color-ink)",
          "card": "var(--royal-color-paper)",
          "card-foreground": "var(--royal-color-ink)",
          "popover": "color-mix(in srgb, var(--royal-color-paper) 92%, transparent)",
          "popover-foreground": "var(--royal-color-ink)",
          "primary": "var(--royal-color-accent)",
          "primary-foreground": "var(--royal-color-on-accent)",
          "secondary": "var(--royal-color-wash)",
          "secondary-foreground": "var(--royal-color-ink)",
          "muted": "var(--royal-color-wash)",
          "muted-foreground": "var(--royal-color-muted)",
          "accent": "var(--royal-color-wash)",
          "accent-foreground": "var(--royal-color-accent-text)",
          "destructive": "var(--royal-color-error)",
          "border": "var(--royal-color-rule)",
          "input": "var(--royal-color-rule)",
          "ring": "var(--royal-color-focus)",
          "chart-1": "var(--royal-color-series-1)",
          "chart-2": "var(--royal-color-series-2)",
          "chart-3": "var(--royal-color-series-3)",
          "chart-4": "var(--royal-color-series-4)",
          "chart-5": "var(--royal-color-series-5)",
          "sidebar": "var(--royal-color-wash)",
          "sidebar-foreground": "var(--royal-color-ink)",
          "sidebar-primary": "var(--royal-color-accent)",
          "sidebar-primary-foreground": "var(--royal-color-on-accent)",
          "sidebar-accent": "var(--royal-color-paper)",
          "sidebar-accent-foreground": "var(--royal-color-accent-text)",
          "sidebar-border": "var(--royal-color-rule)",
          "sidebar-ring": "var(--royal-color-focus)",
          "radius": "var(--royal-radius-control)"
        },
        "dark": {
          "background": "var(--royal-color-paper)",
          "foreground": "var(--royal-color-ink)",
          "card": "var(--royal-color-paper)",
          "card-foreground": "var(--royal-color-ink)",
          "popover": "color-mix(in srgb, var(--royal-color-raised) 92%, transparent)",
          "popover-foreground": "var(--royal-color-ink)",
          "primary": "var(--royal-color-accent)",
          "primary-foreground": "var(--royal-color-on-accent)",
          "secondary": "var(--royal-color-wash)",
          "secondary-foreground": "var(--royal-color-ink)",
          "muted": "var(--royal-color-wash)",
          "muted-foreground": "var(--royal-color-muted)",
          "accent": "var(--royal-color-wash)",
          "accent-foreground": "var(--royal-color-accent-text)",
          "destructive": "var(--royal-color-error)",
          "border": "var(--royal-color-rule)",
          "input": "var(--royal-color-rule)",
          "ring": "var(--royal-color-focus)",
          "chart-1": "var(--royal-color-series-1)",
          "chart-2": "var(--royal-color-series-2)",
          "chart-3": "var(--royal-color-series-3)",
          "chart-4": "var(--royal-color-series-4)",
          "chart-5": "var(--royal-color-series-5)",
          "sidebar": "var(--royal-color-wash)",
          "sidebar-foreground": "var(--royal-color-ink)",
          "sidebar-primary": "var(--royal-color-accent)",
          "sidebar-primary-foreground": "var(--royal-color-on-accent)",
          "sidebar-accent": "var(--royal-color-paper)",
          "sidebar-accent-foreground": "var(--royal-color-accent-text)",
          "sidebar-border": "var(--royal-color-rule)",
          "sidebar-ring": "var(--royal-color-focus)",
          "radius": "var(--royal-radius-control)"
        }
      }
